# Segredos e Variáveis de Ambiente
# Para a demonstração, a linha .env fica comentada para permitir o upload:
# .env
!.env.example

# Ambiente Virtual do Python
.venv/
venv/
ENV/
env/

# Cache do Python
__pycache__/
*.py[cod]
*$py.class

# Arquivos do Sistema Operacional
.DS_Store
Thumbs.db

# Configurações de IDEs (VS Code, PyCharm)
.vscode/
.idea/

# Logs e arquivos temporários
*.log